		#autoLOC_600040 = <b>WE CAN BUILD IT!</b>
		#autoLOC_900000 = Wernher Von Kerman
		#autoLOC_900001 = Gene Kerman
		#autoLOC_900002 = Gus Kerman
		#autoLOC_900004 = Mortimer Kerman
