		#autoLOC_500551 = A small container for jet fuel.
		#autoLOC_500552 = fueltank jet ?lf only propellant tank
		#autoLOC_500553 = Mk2 Bicoupler
		#autoLOC_500554 = One engine is not enough? We got you covered!
