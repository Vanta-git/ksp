EXPERIMENT_DEFINITION
{
	id = cometSample_short
	title = #autoLOC_6006053 //#autoLOC_6006053 = Short Period Comet Sample
	baseValue = 90
	scienceCap = 100
	dataScale = 1
	
	requireAtmosphere = False
	requireNoAtmosphere = False
	situationMask = 63
	biomeMask = 7
	
	RESULTS
	{
		default = #autoLOC_6002511 //#autoLOC_6002511 = At some point in the past this comet was swung into a much tighter orbit around the Sun.  Its a good thing you got here now, it may not keep its status as a Comet for much longer wih the way the Sun is boiling off its volatile material. You've got a good scoop of this melting icecream ball to perserve and return for analysis.		
	}	
}

EXPERIMENT_DEFINITION
{
	id = cometSample_intermediate
	title = #autoLOC_6002508 //#autoLOC_6002508 = Intermediate Period Comet Sample
	baseValue = 135
	scienceCap = 150
	dataScale = 1
	
	requireAtmosphere = False
	requireNoAtmosphere = False
	situationMask = 63
	biomeMask = 7
	
	RESULTS
	{
		default = #autoLOC_6002512 //#autoLOC_6002512 = This solar soujourner has been guided by Jool's massive gravity well into a periodic orbit that makes it a regular visitor to the inner system. This sample can help give our scientists a better look at what the protoplanetary disk out past Jool's orbit was composed of. Be careful bringing it back - it's a little melty.
	}	
}

EXPERIMENT_DEFINITION
{
	id = cometSample_long
	title = #autoLOC_6002509 //#autoLOC_6002509 = Long Period Comet Sample
	baseValue = 270
	scienceCap = 300
	dataScale = 1
	
	requireAtmosphere = False
	requireNoAtmosphere = False
	situationMask = 63
	biomeMask = 7
	
	RESULTS
	{
		default = #autoLOC_6002513 //#autoLOC_6002513 = The composition of this comet shows the unique fingerprint of the early Solar system as it has remained untouched on its long lonely journeys that only rarely bring it close to the warmth of the Sun. The smallest microscopic dust embedded into the sample you've carefully packed away contains a treasure of information for our astrogeologists.
	}	
}

EXPERIMENT_DEFINITION
{
	id = cometSample_interstellar
	title = #autoLOC_6002510 //#autoLOC_6002510 = Interstellar Comet Sample
	baseValue = 900
	scienceCap = 1000
	dataScale = 1
	
	requireAtmosphere = False
	requireNoAtmosphere = False
	situationMask = 63
	biomeMask = 7
	
	RESULTS
	{
		default = #autoLOC_6002514 //#autoLOC_6002514 = You've managed to take a sample of one of the rarest pieces of celestial material - a chunk of extra-solar matter. These inter-planetary voyagers travel the space between stars, only rarely diving down into a solar gravity well. Telescopes probe the galaxy far and wide, but actually getting a piece of something from this far away is a unique achievement.
	}	
}



EXPERIMENT_DEFINITION
{
	id = infraredTelescope
	title = #autoLOC_6002282 //#autoLOC_6002282 = Infrared Telescope
	baseValue = 15
	scienceCap = 22
	dataScale = 2
	
	requireAtmosphere = False
	situationMask = 32
	biomeMask = 0
	
	RESULTS
	{
		default = #autoLOC_6002312 //#autoLOC_6002312 = You focus the telescope out into space, scanning for celestial bodies.
		
		KerbinInSpaceHigh = #autoLOC_6002313 //#autoLOC_6002313 = You scan for celestial bodies while orbiting high over Kerbin.
	}

}

EXPERIMENT_DEFINITION
{
	id = magnetometer
	title = #autoLOC_6002501 //#autoLOC_6002501 = Magnetometer Report
	baseValue = 45
	scienceCap = 45
	dataScale = 1
	
	requireAtmosphere = False	
	requireNoAtmosphere = False
	situationMask = 48 //Only valid in space low and in space high.
	biomeMask = 0
	
	RESULTS
	{
		default = #autoLOC_6002502 //#autoLOC_6002502 = You've measured the interaction between the solar wind and the magnetic field of this planet as it deflects charged particles.
		
		KerbinInSpaceHigh = #autoLOC_6002504 //#autoLOC_6002504 = Kerbin's magnetic field is weaker out here, but still easily detectable, and this instrument maps the field fluctations as they radiate into deeper space.
		KerbinInSpaceLow = #autoLOC_6002505 //#autoLOC_6002505 = Kerbin has a strong magnetic field for a planet of its size, shielding us from the Sun's blasts of radiation, even in this low orbit.
		
		MohoInSpaceHigh = #autoLOC_6002502 //#autoLOC_6002502 = You've measured the interaction between the solar wind and the magnetic field of this planet as it deflects charged particles.  
