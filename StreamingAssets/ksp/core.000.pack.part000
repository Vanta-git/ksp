EXPERIMENT_DEFINITION
{
	id = crewReport
	title = #autoLOC_501009 //#autoLOC_501009 = Crew Report
	baseValue = 5
	scienceCap = 5
	dataScale = 1
	
	requireAtmosphere = False
	situationMask = 63
	biomeMask = 7
	
	RESULTS
	{
		default = #autoLOC_501258 //#autoLOC_501258 = You record the crew's assessment of the situation.

		KerbinSrfLandedLaunchpad = #autoLOC_501259 //#autoLOC_501259 = We don't seem to be moving very fast right now.
		KerbinSrfLandedRunway = #autoLOC_501260 //#autoLOC_501260 = Reporting in at the Runway. Good thing there's not a lot of air traffic, because I don't think we ever got clearance from the tower to be here.
		KerbinSrfLandedKSC = #autoLOC_501261 //#autoLOC_501261 = This is our Space Center. We're home.
		KerbinFlyingLowGrasslands = #autoLOC_501262 //#autoLOC_501262 = Hey, I can see my house from here, I think.
		KerbinFlyingLowGrasslands = #autoLOC_501263 //#autoLOC_501263 = It's very comforting to see that much green below you.
		KerbinFlyingLowHighlands = #autoLOC_501264 //#autoLOC_501264 = You get a great view of the highlands.
		KerbinFlyingLowMountains = #autoLOC_501265 //#autoLOC_501265 = The mountains rise up from the ground of Kerbin. They seem so much smaller from way up here.
		KerbinFlyingLowDeserts = #autoLOC_501266 //#autoLOC_501266 = The heat rising from the sand causes the desert to move and shimmer.
		KerbinFlyingLowBadlands = #autoLOC_501267 //#autoLOC_501267 = This looks like a bad place to land.
		KerbinFlyingLowTundra = #autoLOC_501268 //#autoLOC_501268 = You see patches of frozen grass. It looks like it's pretty cold out there.
		KerbinFlyingLowIceCaps = #autoLOC_501269 //#autoLOC_501269 = You look down and see a sheet of shining white ice. If you stare at it too long your eyes start to water.
		KerbinFlyingLowShores = #autoLOC_501270 //#autoLOC_501270 = The shores look inviting and you watch the waves roll in to the coast.
		KerbinFlyingLowWater = #autoLOC_501271 //#autoLOC_501271 = From this perspective you can see the underwater topography.
		KerbinInSpaceLow = #autoLOC_501272 //#autoLOC_501272 = It seems we are very much in space right now. The sky seems to be mostly below us.
		KerbinInSpaceLow = #autoLOC_501273 //#autoLOC_501273 = Maybe if you get out and push...
		KerbinInSpace = #autoLOC_501274 //#autoLOC_501274 = It's very... round.
		KerbinInSpace = #autoLOC_501275 //#autoLOC_501275 = Crew reporting in, from space!

		MunInSpace = #autoLOC_501276 //#autoLOC_501276 = You look down at the cold gray surface. It looks really beat up with craters.
		MunInSpace = #autoLOC_501277 //#autoLOC_501277 = You look at the surface of the Mun and try to find a good landing space. The inside of the craters might be the best option.

		MinmusInSpace = #autoLOC_501278 //#autoLOC_501278 = The lake beds seem relatively flat, perhaps we could land there.
		MinmusInSpace = #autoLOC_501279 //#autoLOC_501279 = Looking at the surface of Minmus reminds you of a favorite childhood dessert. You are tempted to taste the surface...

		GillyInSpace = #autoLOC_501280 //#autoLOC_501280 = It looks like a particularly lumpy rock. Bet you could jetpack down there.

		MohoInSpace = #autoLOC_501281 //#autoLOC_501281 = The planet doesn't appear to have an atmosphere, and you notice darker spots across the surface.

		EveInSpace = #autoLOC_501282 //#autoLOC_501282 = You can't help but notice how incredibly purple the planet is. The shiny oceans are mesmerizing.

		DunaInSpace = #autoLOC_501283 //#autoLOC_501283 = The planet is very red, and appears to have deep brown furrows across the surface. There does appear to be some kind of ice at both poles, though.

		IkeInSpace = #autoLOC_501284 //#autoLOC_501284 = You can't help but like Ike.
		IkeInSpace = #autoLOC_501285 //#autoLOC_501285 = There appear to be some steep, rocky slopes. The higher areas are lighter in color, and the lowlands appear to be very dark gray.

		DresInSpace = #autoLOC_501286 //#autoLOC_501286 = Looking down, you see a massive canyon on the surface. It could be several kilometers deep.
		DresInSpace = #autoLOC_501287 //#autoLOC_501287 = The surface has a patchwork of white and brown areas, with a few craters.

		JoolInSpace = #autoLOC_501288 //#autoLOC_501288 = You watch the flowing green storms below, they seem to go on forever, endlessly swirling into each other.
		JoolInSpace = #autoLOC_501289 //#autoLOC_501289 = This planet is a wholesome green color. You note down that more planets should be this color.

		LaytheInSpace = #autoLOC_501290 //#autoLOC_501290 = Laythe looks a lot like Kerbin. You wonder what would happen if you took your helmet off down there.
		LaytheInSpace = #autoLOC_501291 //#autoLOC_501291 = The surface is mostly covered in oceans. You mark down the landmasses in your report.

		VallInSpace = #autoLOC_501292 //#autoLOC_501292 = The surface has many impressive and jagged mountain ranges. You do not think you'd like to try and land on them.
		VallInSpace = #autoLOC_501293 //#autoLOC_501293 = The moon is mostly white and lighter blue shades. It looks very cold and possibly frozen.

		TyloInSpace = #autoLOC_501294 //#autoLOC_501294 = It looks like it would be very hard to land here. It also appears one side is more heavily cratered than the other.
		TyloInSpace = #autoLOC_501295 //#autoLOC_501295 = The surface is covered with various shades of white and gray. For a second you thought you saw a face down there...

		BopInSpace = #autoLOC_501296 //#autoLOC_501296 = It appears to be a large brown rock. Perhaps an old asteroid?
		BopInSpace = #autoLOC_501297 //#autoLOC_501297 = As you stare at the planet, something flits by the window. Is there something moving down there?

		PolInSpace = #autoLOC_501298 //#autoLOC_501298 = It looks like a really large grain of pollen. You note down -Pol- in your report.
		PolInSpace = #autoLOC_501299 //#autoLOC_501299 = The terrain below looks very hazardous. You make note of the jagged rocks, inclines and other dangerous areas.

		EelooInSpace = #autoLOC_501300 //#autoLOC_501300 = The surface appears to be mostly frozen. You see some interesting brown areas peeking out of the ice and note them in your report.
		EelooInSpace = #autoLOC_501301 //#autoLOC_501301 = You search the sky for other nearby planets.  You think Eeloo must be lonely out here by itself. Maybe we should pay it a visit and cheer it up a bit.
	}
}


EXPERIMENT_DEFINITION
{
	id = evaReport
	title = #autoLOC_501010 //#autoLOC_501010 = EVA Report
	baseValue = 8
	scienceCap = 8
	dataScale = 1
	
	requireAtmosphere = False
	situationMask = 63
	biomeMask = 23
	
	RESULTS
	{
		default = #autoLOC_501302 //#autoLOC_501302 = You've recorded your observations about the situation.

		MohoSrfLanded = #autoLOC_501303 //#autoLOC_501303 = It's getting very hot in here...

		EveSrfLanded = #autoLOC_501304 //#autoLOC_501304 = Everything is tinted purple. You feel like you're changing color.
		EveSrfLanded = #autoLOC_501305 //#autoLOC_501305 = Did you eat too much before you left? You feel so sluggish and heavy...

		GillySrfLanded = #autoLOC_501306 //#autoLOC_501306 = You can barely move without flying away from the surface. You wish you had brought an anchor.

		KerbinSrf = #autoLOC_501307 //#autoLOC_501307 = I don't think a spacesuit was entirely necessary to get here, was it?

		SunInSpaceHigh = #autoLOC_501308 //#autoLOC_501308 = You feel kind of small right now... You hope you know where you're going.

		KerbinFlyingLow = #autoLOC_501309 //#autoLOC_501309 = This is a most precarious situation.
		KerbinFlyingHigh = #autoLOC_501310 //#autoLOC_501310 = You're starting to feel you should really get back into the ship.

		MunSrfLanded = #autoLOC_501311 //#autoLOC_501311 = The dust is getting everywhere!
		MunSrfLanded = #autoLOC_501312 //#autoLOC_501312 = You look up and search the sky for Kerbin. Suddenly, you feel very small.
		MunSrfLanded = #autoLOC_501313 //#autoLOC_501313 = You start to say something dramatic and poignant about the plight of Kerbal-kind in this grand universe, only to be cut off by random radio chatter that the situation is nominal.
		MunFlyingLow = #autoLOC_501314 //#autoLOC_501314 = You're having a bit too much fun with the low gravity.
		MunFlyingHigh = #autoLOC_501315 //#autoLOC_501315 = Is this really a good idea? Staring at the cratered surface below, you're beginning to wonder...

		MinmusSrfLanded = #autoLOC_501316 //#autoLOC_501316 = You feel a bit like a superhero when you jump in the low gravity.

		DunaSrfLanded = #autoLOC_501317 //#autoLOC_501317 = After much testing, you determine that red sand castles are plausible.
		DunaSrfLanded = #autoLOC_501318 //#autoLOC_501318 = Everywhere you look, you see red.

		IkeSrfLanded = #autoLOC_501319 //#autoLOC_501319 = You look up at the sky and see something zip past...
		IkeSrfLanded = #autoLOC_501320 //#autoLOC_501320 = There's a bunch of large rocks scattered around the surface. The surface appears to react oddly to light.

		DresSrfLanded = #autoLOC_501321 //#autoLOC_501321 = When you look closely at the ground, you can see there are many different types of deposits mixed together.

		JoolSrfLanded = #autoLOC_501322 //#autoLOC_501322 = You're not sure how you even landed on the surface of a gas giant. But it's probably best not to think about it for too long.

		LaytheSrfLanded = #autoLOC_501323 //#autoLOC_501323 = This place seems nice and comfortable. So comfortable you feel like taking your helmet off. You check the box on your report for -Looks breathable-.
		LaytheSrfLanded = #autoLOC_501324 //#autoLOC_501324 = After a few long seconds of gasping and haphazardly flailing about you manage to get used to the strange smell. You write a note on your report: 'breathable atmosphere - mouth only'.

		VallSrfLanded = #autoLOC_501325 //#autoLOC_501325 = The surface occasionally rumbles beneath you. You think you should probably get back to the ship.

		TyloSrfLanded = #autoLOC_501326 //#autoLOC_501326 = The gravity here is pretty comfortable and reminds you of home. However, the lack of atmosphere is a stark contrast to Kerbin.

		BopSrfLanded = #autoLOC_501327 //#autoLOC_501327 = The surface is very brown and lumpy. You poke at it with your glove and notice how hard it is.

		PolSrfLanded = #autoLOC_501328 //#autoLOC_501328 = Everywhere you look it appears the planet is sharp. You don't think you want to sit down or fall on anything.

		EelooSrfLanded = #autoLOC_501329 //#autoLOC_501329 = You lay down and give the planet a hug, just so it knows it's not alone out here.
	}
}

EXPERIMENT_DEFINITION
{
	id = mysteryGoo
	title = #autoLOC_501011 //#autoLOC_501011 = Mystery Gooâ„¢ Observation
	baseValue = 10
	scienceCap = 13
	dataScale = 1
	
	requireAtmosphere = False
	situationMask = 63
	biomeMask = 3
	
	RESULTS
	{
		default = #autoLOC_501330 //#autoLOC_501330 = You Observe the Goo.

		KerbinSrfLandedLaunchPad = #autoLOC_501331 //#autoLOC_501331 = The Goo doesn't seem to be doing much right now.
		KerbinSrfLandedRunway = #autoLOC_501332 //#autoLOC_501332 = The Goo seems to behave very much the same as it always does around here.
		KerbinSrfLandedDeserts = #autoLOC_501333 //#autoLOC_501333 = The Goo seems to hate it here.
		KerbinSrfSplashedWater = #autoLOC_501334 //#autoLOC_501334 = The Goo escapes into the water!
		KerbinSrfSplashedShores = #autoLOC_501335 //#autoLOC_501335 = The Goo wobbles around in its container and starts to seep out of the holes.
		KerbinSrfLandedShores = #autoLOC_501336 //#autoLOC_501336 = The Goo accumulates near the water-facing side of the container.
		KerbinSrfLandedKSC = #autoLOC_501337 //#autoLOC_501337 = The Goo seems bored.
		KerbinFlyingLow = #autoLOC_501338 //#autoLOC_501338 = The Goo jiggles and wobbles as the craft flies.
		KerbinFlyingHigh = #autoLOC_501339 //#autoLOC_501339 = The Goo seems to be getting very cold now.
		KerbinInSpaceLow = #autoLOC_501340 //#autoLOC_501340 = The Goo seems to have clumped into a sphere. It also appears to have become brittle.

		MohoInSpace = #autoLOC_501341 //#autoLOC_501341 = The Goo seems to be almost boiling. It writhes around the canister.

		EveInSpace = #autoLOC_501342 //#autoLOC_501342 = The Goo has become rubbery and bounces around the container.
		EveInSpace = #autoLOC_501343 //#autoLOC_501343 = The Goo takes on a purple coloration. Is it just the lighting, or did it change color?

		DunaInSpace = #autoLOC_501344 //#autoLOC_501344 = The Goo takes on a red sheen. It looks very much like the planet below.

		Mun = #autoLOC_501345 //#autoLOC_501345 = The Goo seems to be less dense here.

		InSpace = #autoLOC_501346 //#autoLOC_501346 = The Goo feels right at home here.

		BopInSpace = #autoLOC_501347 //#autoLOC_501347 = The canister begins to resonate, causing an odd harmonic effect inside the vessel. It's very unsettling.

		PolInSpace = #autoLOC_501348 //#autoLOC_501348 = Gooey tentacles reach out of the canister, freeze, and break off. Fascinating!

		EeLooInSpace = #autoLOC_501349 //#autoLOC_501349 = While observing the canister, you feel as though something is looking back at you from the shadows of the container.

		EeLooInSpace = #autoLOC_501350 //#autoLOC_501350 = For a moment the instruments suddenly read off the charts! The container flexes outwards and then settles.
		
	}
}



EXPERIMENT_DEFINITION
{
	id = surfaceSample
	title = #autoLOC_501012 //#autoLOC_501012 = Surface Sample
	baseValue = 30
	scienceCap = 40
	dataScale = 1
	
	requireAtmosphere = False
	situationMask = 3
	biomeMask = 3
	requiredExperimentLevel = 0.5
	
	RESULTS
	{
		default = #autoLOC_501351 //#autoLOC_501351 = You've collected a sample of the surface.
		default = #autoLOC_501352 //#autoLOC_501352 = You dig around in the surface a bit, find something interesting, and throw it into a sample container.
		default = #autoLOC_501353 //#autoLOC_501353 = You poke at the ground looking for some really cool rocks to take home.

		KerbinSrfLandedGrasslands = #autoLOC_501354 //#autoLOC_501354 = Yep. Looks like dirt.
		KerbinSrfLandedHighlands = #autoLOC_501355 //#autoLOC_501355 = This is dirt and grass, and some small rocks. You suspect this isn't going to be much of a groundbreaking discovery.
		KerbinSrfLandedMountains = #autoLOC_501356 //#autoLOC_501356 = Here the surface is mostly barren... snow, dirt and rocks. You're very confident that if you looked under the snow, you'd find more dirt and rocks.
		KerbinSrfLandedDeserts = #autoLOC_501357 //#autoLOC_501357 = Lots of sand and rocks here. You're thankful that you've been in a climate-controlled environment, because it sure looks hot out there. The sand is dry and loose and it looks like it's going to take some effort to clean your gear afterwards.
		KerbinSrfLandedTundra = #autoLOC_501358 //#autoLOC_501358 = The ground here seems to be completely frozen. It was very hard to scoop up this sample.
		KerbinSrfLandedIceCaps = #autoLOC_501359 //#autoLOC_501359 = This isn't really solid ground, is it? You got a sample but feared to dig any deeper because of the startling cracking sounds the ice made. You try to not think back on how you landed here.
		KerbinSrfLandedShores = #autoLOC_501360 //#autoLOC_501360 = You took a sample of the soil. It's very muddy and sandy. There might be a body of water nearby.
		KerbinSrfLandedBadlands = #autoLOC_501361 //#autoLOC_501361 = The grass here is definitely not as green as other places, but the knowledge that you've been at a place called the Badlands makes you feel cool.
		KerbinSrfLandedWater = #autoLOC_501362 //#autoLOC_501362 = You scooped up a sample of the surface. It's a very humid sample.  You hope the equipment has been properly waterproofed.
		KerbinSrfSplashedWater = #autoLOC_501363 //#autoLOC_501363 = You've taken a sample of the water. It appears to dramatically increase the surface humidity of anything it touches.
		KerbinSrfSplashedShores = #autoLOC_501364 //#autoLOC_501364 = You've taken a sample of the water here. There are bits of vegetation in it, suggesting a strong likelihood that there is land nearby.
		KerbinSrfLandedLaunchPad = #autoLOC_501365 //#autoLOC_501365 = The surface is charred and coated with burnt rocket propellant. There are also trace amounts of a conspicuous green substance.
		KerbinSrfLandedRunway = #autoLOC_501366 //#autoLOC_501366 = The surface appears to be very hard, like concrete. It might actually be concrete. This could be a very good surface to land at.
		KerbinSrfLandedKSC = #autoLOC_501367 //#autoLOC_501367 = This substance is what makes the scientists yell at us when we go into the labs without cleaning our boots first.

		MunSrfLanded = #autoLOC_501368 //#autoLOC_501368 = The surface appears to be a fine dust with a grey-ish tone. Seems too flaky to make snowballs with.
		MunSrfLandedMidlands = #autoLOC_501369 //#autoLOC_501369 = The darker midlands surface appears to be made up of basaltic rocks.
		MunSrfLandedMidlands = #autoLOC_501370 //#autoLOC_501370 = The sample contains odd glass spherules of various colors. They're quite pretty!
		MunSrfLandedNorthernBasin = #autoLOC_501371 //#autoLOC_501371 = The sample contains evidence of a weak, localized, magnetic field.
		MunSrfLandedNorthernBasin = #autoLOC_501372 //#autoLOC_501372 = The surface here consists of multiple types of rock. Some appear almost crystalline.
		MunSrfLandedEastCrater = #autoLOC_501373 //#autoLOC_501373 = The sample contains a combination of breccia and melted materials.
		MunSrfLandedEastCrater = #autoLOC_501374 //#autoLOC_501374 = There are higher concentrations of metals in this crater than from other locations.
		MunSrfLandedNorthwestCrater = #autoLOC_501375 //#autoLOC_501375 = The ground materials appear to be a combination of basaltic rocks and breccia.
		MunSrfLandedNorthWestCrater = #autoLOC_501376 //#autoLOC_501376 = Deeper samples seem to contain more fragmented and shattered formations of rock.
		MunSrfLandedSouthwestCrater = #autoLOC_501377 //#autoLOC_501377 = The sample appears to be radioactive.
		MunSrfLandedSouthWestCrater = #autoLOC_501378 //#autoLOC_501378 = There appear to be layers of completely different materials here.  It's possible this site has had multiple impacts.
		MunSrfLandedFarsideCrater = #autoLOC_501379 //#autoLOC_501379 = There are large concentrations of melted byproducts here. Some appear to be formed by intense pressures and heat.
		MunSrfLandedFarsideCrater = #autoLOC_501380 //#autoLOC_501380 = Samples from this location appear to be similar in makeup to the powdery surface of the Mun.
		MunSrfLandedCanyons = #autoLOC_501381 //#autoLOC_501381 = Samples in this location are striated. It's possible that the surface has fractured in this location.
		MunSrfLandedPolarCrater = #autoLOC_501382 //#autoLOC_501382 = Samples from this location seem to show intense shock patterns.
		MunSrfLandedPolarCrater = #autoLOC_501383 //#autoLOC_501383 = It appears that some of the samples are magnetic and show a faint alignment.
		MunSrfLandedPoles = #autoLOC_501384 //#autoLOC_501384 = The samples here show lower concentrations of ejecta. There appear to be some liquids in the soil that remain permanently frozen.
		MunSrfLandedPolarLowlands = #autoLOC_501385 //#autoLOC_501385 = Samples seems to contain frozen liquids... We'll need to send them back to Kerbin for further analysis.
		MunSrfLandedHighlands = #autoLOC_501386 //#autoLOC_501386 = The sample appears to be comprised of a large number of materials layered over time.
		MunSrfLandedHighlands = #autoLOC_501387 //#autoLOC_501387 = The sample contains lesser amounts of basaltic rocks. This might account for the changes in coloration we've seen.
		MunSrfLandedHighlandCraters = #autoLOC_501388 //#autoLOC_501388 = The crater seems to contain materials from lower layers of the surface!
		MunSrfLandedHighlandCraters = #autoLOC_501389 //#autoLOC_501389 = These samples appear to be quite old compared to others we've taken.
		MunSrfLandedHighlandCraters = #autoLOC_501390 //#autoLOC_501390 = You sample the dark surface of the crater. This should help determine what type of object hit here.
		MunSrfLandedHighlandCraters = #autoLOC_501391 //#autoLOC_501391 = This crater seems to be filled with useful materials in high concentration. What luck!
		MunSrfLandedMidlandCraters = #autoLOC_501392 //#autoLOC_501392 = The patterning of this surface sample is particularly interesting.
		MunSrfLandedMidlandCraters = #autoLOC_501393 //#autoLOC_501393 = As you sample the crater you can't help but feel bad for the Mun. It's been beaten up pretty bad by these impacts.
		MunSrfLandedMidlandCraters = #autoLOC_501394 //#autoLOC_501394 = You dig around in the surface of the crater, looking for any rocks that look neat.
		MunSrfLandedMidlandCraters = #autoLOC_501395 //#autoLOC_501395 = You find a really cool looking rock and decide to keep it. Remembering that you're supposed to take a surface sample, you throw any old rocks you find into the container. Job done!
		MunSrfLandedMidlandCraters = #autoLOC_501396 //#autoLOC_501396 = Yep, it's a crater all right. You've noted this down on your checklist with a smiley face. Science is fun!
		MunSrfLandedEastFarsideCrater = #autoLOC_501397 //#autoLOC_501397 = This crater seems to have been a really nasty impact, and the samples are heavier than normal.
		MunSrfLandedEastFarsideCrater = #autoLOC_501398 //#autoLOC_501398 = You're glad that the Mun's gravity is so low. Digging is backbreaking work!
		MunSrfLandedTwinCraters = #autoLOC_501399 //#autoLOC_501399 = This area has a particularly high concentration of rare elements. Nice!
		MunSrfLandedTwinCraters = #autoLOC_501400 //#autoLOC_501400 = Continual samples of this area confirm it is rich in useful materials.
		MunSrfLandedTwinCraters = #autoLOC_501401 //#autoLOC_501401 = You dig around for a nice sample of the crater, carefully selecting a little bit of everything.
		
		MinmusSrfLanded = #autoLOC_501402 //#autoLOC_501402 = The surface seems to consist of tiny crystal-like grains. Very pretty, but probably not edible.
		MinmusSrfLanded = #autoLOC_501403 //#autoLOC_501403 = You sneak a taste of the surface sample... Nope, it definitely is not made of delicious dessert products.

		EveSrfLanded = #autoLOC_501404 //#autoLOC_501404 = The surface appears to have a very strong purple tint to it... or is it grey and it just looks purple because everything else on Eve is? You start to wonder if you're not taking on a purple tint yourself.

		DunaSrfLanded = #autoLOC_501405 //#autoLOC_501405 = This surface consists of a grainy, very fine, sand-like dust, and it appears to be getting everywhere.
		DunaSrfLanded = #autoLOC_501406 //#autoLOC_501406 = There appear to be traces of water in the soil!
		DunaSrfLanded = #autoLOC_501407 //#autoLOC_501407 = Unable to satisfy your curiousity, you attempt to drill into the rock with your tool. You're thinking it would be a lot easier if you had some kind of pulsating drill-thing on a robotic arm.

		MohoSrfLanded = #autoLOC_501408 //#autoLOC_501408 = The ground is made up of old lava flows, suggesting periods of intense volcanic activity.

		GillySrfLanded = #autoLOC_501409 //#autoLOC_501409 = The surface gives away easily and you have a hard time keeping the sample in the container due to the low gravity.
		GillySrfLanded = #autoLOC_501410 //#autoLOC_501410 = The composition of elements is very similar to that of an asteroid.

		IkeSrfLanded = #autoLOC_501411 //#autoLOC_501411 = The Dark black soil has an almost crystalline structure. It's fun to play with.
		IkeSrfLanded = #autoLOC_501412 //#autoLOC_501412 = The white soil has a powdery texture and clumps together.

		DresSrfLanded = #autoLOC_501413 //#autoLOC_501413 = You find traces of a large number of elements, likely deposited here by impacts over time.
		DresSrfLanded = #autoLOC_501414 //#autoLOC_501414 = After digging around for a bit, you find some nice bits of glass and throw them in your sample container.

		LaytheSrfLanded = #autoLOC_501415 //#autoLOC_501415 = The soil sample contains traces of salt. You wonder if it has blown here, or if this area was once under water.

		VallSrfLanded = #autoLOC_501416 //#autoLOC_501416 = You chip away the frozen surface and deposit some of the blue surface material into a container.
		VallSrfLanded = #autoLOC_501417 //#autoLOC_501417 = You dig around in the surface and find some beautiful green and blue crystal structures. They remind you a bit of home, but you're unable to pick out Kerbin from the mass of twinkling lights.

		TyloSrfLanded = #autoLOC_501418 //#autoLOC_501418 = The ground gives way easily, but the surface underneath is much harder.
		TyloSrfLanded = #autoLOC_501419 //#autoLOC_501419 = You hum a little tune while you work to make the time pass faster. Tylo has some really interesting rocks!

		BopSrfLanded = #autoLOC_501420 //#autoLOC_501420 = The brown dust stains all the parts of your suit that it comes in contact with. This is apparently quite amusing to flight control.
		BopSrfLanded = #autoLOC_501421 //#autoLOC_501421 = You dig through the surface and find a little sphere. It looks a bit like an egg.

		PolSrfLanded = #autoLOC_501422 //#autoLOC_501422 = As you shovel the contents into a container, you can't help but feel you'll be allergic to whatever it is.
		PolSrfLanded = #autoLOC_501423 //#autoLOC_501423 = The sample is the same odd mottle of colors as the planet from orbit. You check off a little box on your list.
		PolSrfLanded = #autoLOC_501424 //#autoLOC_501424 = After conducting samples of the surface, you determine with a high certainty that Pol is not, in fact, made of Pollen. This will cause quite the stir back home!

		EelooSrfLanded = #autoLOC_501425 //#autoLOC_501425 = Chipping away at the icy surface, you find some brown soil underneath.
		EelooSrfLanded = #autoLOC_501426 //#autoLOC_501426 = You find a beautiful crystal and place it in the sample container.
		EelooSrfLanded = #autoLOC_501427 //#autoLOC_501427 = The rocks contain thin wisps of color. They remind you of lovely ION exhaust trails...
	}	
}

EXPERIMENT_DEFINITION
{
	id = mobileMaterialsLab
	title = #autoLOC_501013 //#autoLOC_501013 = Materials Study
	baseValue = 25
	scienceCap = 32
	dataScale = 1
	
	requireAtmosphere = False
	situationMask = 63
	biomeMask = 3
	
	RESULTS
	{
		default = #autoLOC_501428 //#autoLOC_501428 = You exposed the material samples to the environment, taking notes of how it behaves.

		SunFlyingLow = #autoLOC_501429 //#autoLOC_501429 = Everything is melting, including the electronicsssss.........

		MohoSrfLanded = #autoLOC_501430 //#autoLOC_501430 = The materials bay bakes in the heat of Moho's surface. It appears that trace elements are reacting to the samples contained within.
		MohoSrfLanded = #autoLOC_501431 //#autoLOC_501431 = You expose the samples to the high temperatures of Moho. A lot of them melt in really interesting ways.

		KerbinSrfLanded = #autoLOC_501432 //#autoLOC_501432 = The materials show little signs of change, though one of the samples appears to be judging you silently.
		KerbinSrfLandedDeserts = #autoLOC_501433 //#autoLOC_501433 = The desert dust appears to have contaminated all the samples. We did learn that deserts aren't a good place to bring expensive science equipment, though!
		KerbinSrfLandedIceCaps = #autoLOC_501434 //#autoLOC_501434 = The water sample has frozen solid and the goopy samples appear to be extra goopy.
		KerbinSrfLandedShores = #autoLOC_501435 //#autoLOC_501435 = The water spray has rusted one of the samples and some of the electronics ar&/F***13e5rse4t8st######
		KerbinSrfLandedWater = #autoLOC_501436 //#autoLOC_501436 = Everything has gotten really wet. One of the samples caught fire! Whoa!
		KerbinSrfLandedWater = #autoLOC_501437 //#autoLOC_501437 = Exposing the power source of the lab to water has proved to be rather... enlightening.
		KerbinSrfLandedBadlands = #autoLOC_501438 //#autoLOC_501438 = You expose the samples to the badlands of Kerbin, but worry that it may have a bad influence on them.
		KerbinFlyingLow = #autoLOC_501439 //#autoLOC_501439 = The less resilient samples appear to have splattered around the interior, forming new and interesting color combinations.
		KerbinFlyingHigh = #autoLOC_501440 //#autoLOC_501440 = The rarified air has caused interesting changes to the gel samples. It seems like something is happening with the interior structure.
		KerbinInSpaceLow = #autoLOC_501441 //#autoLOC_501441 = The micro gravity has greatly affected the growth of crystalline structures. Loose objects are also flying around the bay in a very messy but fascinating way.

		MunSrfLanded = #autoLOC_501442 //#autoLOC_501442 = The fine dust of the Mun has intermixed with some of the samples. You have a sneaking suspicion that they'll never be able to get the lab clean again.
		MunSrfLanded = #autoLOC_501443 //#autoLOC_501443 = You leave the sample bay doors open on the Mun, and go do something else for a while.
		
		MinmusSrfLanded = #autoLOC_501444 //#autoLOC_501444 = While the material samples were processed, you began to turn your thoughts to how much Minmus looks like a mint dessert, and have discovered that you are now hungry.

		InSpace = #autoLOC_501445 //#autoLOC_501445 = The high radiation environment caused a few of the samples to glow. It looks like it would be fun to paint the rocket with this.

		EveSrfLanded = #autoLOC_501446 //#autoLOC_501446 = The crushing pressure of the atmosphere is causing some of the materials to crystallize rapidly.
		EveSrfLanded = #autoLOC_501447 //#autoLOC_501447 = You're not sure if most of the samples changed color, or if it's just the lighting...
		EveFlyingHigh = #autoLOC_501448 //#autoLOC_501448 = The extremely dense atmosphere strips the contents of the materials bay.
		EveFlyingLow = #autoLOC_501449 //#autoLOC_501449 = The atmosphere appears to either polish or strip the material, depending on its composition.

		GillySrfLanded = #autoLOC_501450 //#autoLOC_501450 = The samples appear to behave like they're in low orbit of Kerbin.
		GillySrfLanded = #autoLOC_501451 //#autoLOC_501451 = Some of the surface material has mixed with the contents of the bay. You write down the results for good measure.

		DunaSrfLanded = #autoLOC_501452 //#autoLOC_501452 = Opening the sample container you find that everything has turned red. Initial tests show that it'll never wash out of white space suits. You consider sending missions in pink EVA suits to reduce cleaning costs.
		DunaSrfLanded = #autoLOC_501453 //#autoLOC_501453 = The sample computer processes the results. It's massive red eye seems to be at home here as it slowly, ominously, blinks.

		IkeSrfLanded = #autoLOC_501454 //#autoLOC_501454 = One of the samples has reacted very strangely to the surface of Ike.
		IkeSrfLanded = #autoLOC_501455 //#autoLOC_501455 = One of the crystal samples explodes and throws green shards out of the materials bay!

		DresSrfLanded = #autoLOC_501456 //#autoLOC_501456 = As the samples process, the computer asks if it can sing you a song while it works. Apparently the song is about a flower of some kind.
		DresSrfLanded = #autoLOC_501457 //#autoLOC_501457 = One of the samples evaporates when exposed the environment.

		JoolInSpace = #autoLOC_501458 //#autoLOC_501458 = The computer gave an odd report no matter how many times we sent the request. Open the sample bay doors... "I'm sorry, I'm afraid I can't let you do that," was the only reply. The doors did open very promptly, however, when we opened the fusebox panel. Very curious.
		JoolFlyingHigh = #autoLOC_501459 //#autoLOC_501459 = The intense, crushing pressure has drastically changed the composition of the materials. Super heating and ablation effects have been observed. The science bay is looking very disgruntled.
		JoolFlyingLow = #autoLOC_501460 //#autoLOC_501460 = The samples burn, boil, or crumple under the extreme pressures and heat. The visual camera shows a wonderful rainbow of colors before it cuts out.
		JoolSrfLanded = #autoLOC_501461 //#autoLOC_501461 = You're not sure where the container stops and the samples start anymore...

		LaytheFlyingHigh = #autoLOC_501462 //#autoLOC_501462 = One of the samples burns on contact with the atmosphere. Interestingly, the color indicates the presence of oxygen.
		LaytheFlyingLow = #autoLOC_501463 //#autoLOC_501463 = The sample smolders and pops as it burns up.
		LaytheSrfLanded = #autoLOC_501464 //#autoLOC_501464 = The fine, particulate sand of Laythe blows into the sample bay.
		LaytheSrfSplashed = #autoLOC_501465 //#autoLOC_501465 = The sample bay power supply begins to short out! Electricity arcs and etches into the samples of the bay. It's quite the display!

		VallSrfLanded = #autoLOC_501466 //#autoLOC_501466 = Many of the samples either freeze or evaporate from the sample container.
		VallSrfLanded = #autoLOC_501467 //#autoLOC_501467 = The container sample door freezes up, before finally continuing to open. A thin coating forms on the surface of the samples.

		TyloSrfLanded = #autoLOC_501468 //#autoLOC_501468 = One of the samples shatters into a fine mist when exposed to the surface of Tylo.
		
		BopSrfLanded = #autoLOC_501469 //#autoLOC_501469 = The samples appear to be having a chemical reaction with the surface of Bop.
		BopSrfLanded = #autoLOC_501470 //#autoLOC_501470 = All of the liquid samples instantly evaporate.

		PolSrfLanded = #autoLOC_501471 //#autoLOC_501471 = Some of the samples pit and melt when they come in contact with the surface of Pol!

		EelooSrfLanded = #autoLOC_501472 //#autoLOC_501472 = Some of the fine crystals lining Eeloo enter the materials bay. It also appears that some of the samples have become more conductive in the extreme cold.
		
	}	
}

EXPERIMENT_DEFINITION
{	
	id = temperatureScan
	title = #autoLOC_501014 //#autoLOC_501014 = Temperature Scan
	baseValue = 8
	scienceCap = 8
	dataScale = 1
	
	requireAtmosphere = False
	situationMask = 63
	biomeMask = 7
	
	RESULTS
	{
		default = #autoLOC_501473 //#autoLOC_501473 = Collected and recorded temperature data from the environment.

		KerbinSrfLanded = #autoLOC_501474 //#autoLOC_501474 = Temperature readings are quite literally, nominal.
		KerbinSrfLandedDeserts = #autoLOC_501475 //#autoLOC_501475 = Large plumes of heat are rising from the surface of the desert.
		KerbinSrfLandedIceCaps = #autoLOC_501476 //#autoLOC_501476 = It's cold enough to freeze water solid.
		KerbinSrfLandedShores = #autoLOC_501477 //#autoLOC_501477 = Just the right temperature to go for a swim.
		KerbinSrfLandedWater = #autoLOC_501478 //#autoLOC_501478 = The water appears to get colder as the depth increases.
		KerbinSrfLandedTundra = #autoLOC_501479 //#autoLOC_501479 = It's cold enough to keep things permanently frozen here.
		KerbinSrfLandedGrasslands = #autoLOC_501480 //#autoLOC_501480 = The temperature here is quite pleasant, and would be a nice place to live.
		KerbinSrfBadlands = #autoLOC_501481 //#autoLOC_501481 = the temperature appears to fluctuate here a good bit, depending on the time of day.

		MohoSrfLanded = #autoLOC_501482 //#autoLOC_501482 = The temperature is very high and appears to fluctuate to extremes in the sunlight.

		EveSrfLanded = #autoLOC_501483 //#autoLOC_501483 = Temperatures range between very cold and hot enough to boil water.
		
		SpaceHigh = #autoLOC_501484 //#autoLOC_501484 = Measuring the temperature of space appears to be quite impossible, as there is no matter around to be either hot or cold... except the spacecraft, and the thermometer itself. This is probably going to give the R&D guys something to think about for a while.
	}
}

EXPERIMENT_DEFINITION
{	
	id = barometerScan
	title = #autoLOC_501015 //#autoLOC_501015 = Atmospheric Pressure Scan
	baseValue = 12
	scienceCap = 12
	dataScale = 1
	
	requireAtmosphere = False
	situationMask = 63
	biomeMask = 3
	
	RESULTS
	{
		default = #autoLOC_501485 //#autoLOC_501485 = Collected and recorded atmospheric pressure data from the surroundings.

		MohoFlyingLow = #autoLOC_501486 //#autoLOC_501486 = The barometer reading is too low to measure. This planet has no atmosphere.
		MohoSrfLanded = #autoLOC_501487 //#autoLOC_501487 = The barometer is still reading nothing.

		EveFlyingLow = #autoLOC_501488 //#autoLOC_501488 = The atmospheric pressure is very high, even at this altitude.
		EveSrfLanded = #autoLOC_501489 //#autoLOC_501489 = The atmosphere is very dense at the surface. It crushes down on the instrumentation.

		GillyFlyingLow = #autoLOC_501490 //#autoLOC_501490 = Either the instruments are broken, or there is no atmosphere on this rock.
		GillySrfLanded = #autoLOC_501491 //#autoLOC_501491 = You think that you have a reading for a second, but nope; it was just a smudge on the gauge.

		MunFlyingLow = #autoLOC_501492 //#autoLOC_501492 = Just for kicks you measure the pressure here. Yep, no atmosphere.
		MunSrfLanded = #autoLOC_501493 //#autoLOC_501493 = The pressure gauge is sitting there motionless. Perhaps you should tap it a few times to be sure?
		MunSrfLanded = #autoLOC_501494 //#autoLOC_501494 = They say insanity is doing the same thing multiple times and expecting a different result. You check the atmospheric pressure again anyways.

		DunaFlyingLow = #autoLOC_501495 //#autoLOC_501495 = The atmosphere is very thin here, but it is enough to register on the instrumentation.
		DunaSrfLanded = #autoLOC_501496 //#autoLOC_501496 = The atmosphere is pretty thin even at the surface. You don't think parachutes or wings would work very well here.

		IkeFlyingLow = #autoLOC_501497 //#autoLOC_501497 = There appears to be no atmosphere here.
		IkeSrfLanded = #autoLOC_501498 //#autoLOC_501498 = The gauge reads nothing, even on the surface.

		JoolFlyingLow = #autoLOC_501499 //#autoLOC_501499 = The pressures here are immense. The instrument is beginning to fail.
		JoolFlyingHigh = #autoLOC_501500 //#autoLOC_501500 = The pressures are very high. It seems dangerous to probe any deeper.
		JoolSrfLanded = #autoLOC_501501 //#autoLOC_501501 = Either the pressure is really high, or the instrument just melted. It's hard to tell what happened first.

		LaytheFlyingLow = #autoLOC_501502 //#autoLOC_501502 = There is definitely an atmosphere. Pressures are fairly nominal.
		LaytheSrfLanded = #autoLOC_501503 //#autoLOC_501503 = The pressures here seem to be a bit below that of Kerbin, but definitely at a manageable level.

		VallFlyingLow = #autoLOC_501504 //#autoLOC_501504 = There does not appear to be any atmosphere to sample.
		VallSrfLanded = #autoLOC_501505 //#autoLOC_501505 = Gasses rising for the planet appear to occasionally register slight pressures. Either that, or the instrument is on the fritz.
		VallSrfLanded = #autoLOC_501506 //#autoLOC_501506 = Just to be sure, you check the pressure a few times. You think you saw the gauge move a bit.

		TyloFlyingLow = #autoLOC_501507 //#autoLOC_501507 = Surprisingly, you discover no traces of atmosphere.
		TyloSrfLanded = #autoLOC_501508 //#autoLOC_501508 = There is no detectable atmospheric pressure here. Fascinating!

		BopFlyingLow = #autoLOC_501509 //#autoLOC_501509 = It's a giant space rock. What did you expect to find?
		BopSrfLanded = #autoLOC_501510 //#autoLOC_501510 = Still nothing. Definitely just a space rock.

		PolFlyingLow = #autoLOC_501511 //#autoLOC_501511 = Nothing to report here.
		PolSrfLanded = #autoLOC_501512 //#autoLOC_501512 = No atmospheric pressure is detectable on Pol.

		EelooSrfLanded = #autoLOC_501513 //#autoLOC_501513 = Beep, beep, beep... boop. The instrument has frozen up.
		EelooFlyingLow = #autoLOC_501514 //#autoLOC_501514 = The instrument can't register any pressure here.
		
		KerbinSpaceLow = #autoLOC_501515 //#autoLOC_501515 = Atmospheric pressure reads zero! This most assuredly indicates we must be in space now!
		KerbinSpaceHigh = #autoLOC_501516 //#autoLOC_501516 = There seems to be no atmosphere at all this far away from home. You find this strangely meaningful.
		
		Space = #autoLOC_501517 //#autoLOC_501517 = The instrument reads zero. It's as if it were in a vacuum!
	}
}

EXPERIMENT_DEFINITION
{	
	id = seismicScan
	title = #autoLOC_501016 //#autoLOC_501016 = Seismic Scan
	baseValue = 20
	scienceCap = 22	
	dataScale = 2.5
	
	requireAtmosphere = False
	situationMask = 1
	biomeMask = 1
	
	RESULTS
	{
		default = #autoLOC_501518 //#autoLOC_501518 = Gathered precise acceleration data while subjecting the vessel to this situation.

		MohoSrfLanded = #autoLOC_501519 //#autoLOC_501519 = The sensor detects vibrations deep inside the planet. It appears that the interior is very volcanically active.
		MohoSrfLanded = #autoLOC_501520 //#autoLOC_501520 = Odd reflections are detected in the recorded vibrations. This might tell us more about the interior structure.

		EveSrfLanded = #autoLOC_501521 //#autoLOC_501521 = The sensor has detected possible seismic activity below the surface.
		EveSrfLanded = #autoLOC_501522 //#autoLOC_501522 = The vibrations, though slight, might be enough to map the interior structure of the planet.

		GillySrfLanded = #autoLOC_501523 //#autoLOC_501523 = This area appears to be seismically dead.
		GillySrfLanded = #autoLOC_501524 //#autoLOC_501524 = The only vibrations we detect are coming from the landing craft. The vibrations do not travel well through the surface.

		MunSrfLanded = #autoLOC_501525 //#autoLOC_501525 = The sensor has detected a minor quake on the surface!
		MunSrfLanded = #autoLOC_501526 //#autoLOC_501526 = The sensor picks up distant impacts on the surface, reflecting along the interior of the Mun.

		MinmusSrfLanded = #autoLOC_501527 //#autoLOC_501527 = Faint seismic waves are detected.
		MinmusSrfLanded = #autoLOC_501528 //#autoLOC_501528 = Sounds of shifting and vibration are detected under the surface. It is possible that the interior is not completely frozen.

		DunaSrfLanded = #autoLOC_501529 //#autoLOC_501529 = The sensor gives insight into the seismic activity of Duna.
		DunaSrfLanded = #autoLOC_501530 //#autoLOC_501530 = There does not appear to be significant seismic activity on the planet. It is possible that it is no longer geologically active.

		DresSrfLanded = #autoLOC_501531 //#autoLOC_501531 = This planet appears to be seismically inactive.
		DresSrfLanded = #autoLOC_501532 //#autoLOC_501532 = periodic bombardments appear to be causing slight vibrations and surface quakes.
		DresSrfLanded = #autoLOC_501533 //#autoLOC_501533 = Changes in the speed of vibrations hint to differing materials under the surface.

		JoolSrfLanded = #autoLOC_501534 //#autoLOC_501534 = The sensor doesn't even know what to do with itself here.
		JoolSrfLanded = #autoLOC_501535 //#autoLOC_501535 = The sensor has informed you that the warranty has just been voided. No refunds.

		LaytheSrfLanded = #autoLOC_501536 //#autoLOC_501536 = Tidal forces appear to be churning the interior of the moon.
		LaytheSrfLanded = #autoLOC_501537 //#autoLOC_501537 = Vibrations under the surface indicate current geological activity.

		VallSrfLanded = #autoLOC_501538 //#autoLOC_501538 = Sensors detect signs of cryovolcanism along the surface.
		VallSrfLanded = #autoLOC_501539 //#autoLOC_501539 = The sensor picks up vibrations reflecting around the interior of the moon.

		TyloSrfLanded = #autoLOC_501540 //#autoLOC_501540 = The moon appears to be largely inactive.
		TyloSrfLanded = #autoLOC_501541 //#autoLOC_501541 = The sensor records even the slightest surface vibration.

		BopSrfLanded = #autoLOC_501542 //#autoLOC_501542 = There does not appear to be any major seismic activity on Bop.
		BopSrfLanded = #autoLOC_501543 //#autoLOC_501543 = A seismic event is detected in the distance, as if a large object had just impacted the surface.

		PolSrfLanded = #autoLOC_501544 //#autoLOC_501544 = The loose soil transmits vibration differently than on other bodies.
		PolSrfLanded = #autoLOC_501545 //#autoLOC_501545 = Vibrations reflect off the jagged structures inside the moon.

		EelooSrfLanded = #autoLOC_501546 //#autoLOC_501546 = Cryovolcanic activity is detected in the interior of the planet.
		EelooSrfLanded = #autoLOC_501547 //#autoLOC_501547 = The sensor picks up low frequency sounds.
	}
}

EXPERIMENT_DEFINITION
{	
	id = gravityScan
	title = #autoLOC_501017 //#autoLOC_501017 = Gravity Scan
	baseValue = 20
	scienceCap = 22
	dataScale = 3
	
	requireAtmosphere = False
	situationMask = 51
	biomeMask = 51
	
	RESULTS
	{
		default = #autoLOC_501548 //#autoLOC_501548 = Recorded accurate measurements of gravitational forces in these conditions.

		MohoInSpace = #autoLOC_501549 //#autoLOC_501549 = The sensor passes over the terrain of Moho surveying for variances in the gravitational field.
		MohoSrfLanded = #autoLOC_501550 //#autoLOC_501550 = Landing here has provided a very accurate and stable measure of gravitational forces.

		EveInSpace = #autoLOC_501551 //#autoLOC_501551 = The sensor records slight variances in gravity as you pass over a massive crater site.
		EveSrfLanded = #autoLOC_501552 //#autoLOC_501552 = The gravitational field is very strong here. The sensor records detailed data about the local field.

		GillyInSpace = #autoLOC_501553 //#autoLOC_501553 = The sensor picks up the fluctuations in the gravity of this lumpy body.
		GillySrfLanded = #autoLOC_501554 //#autoLOC_501554 = The team back at KSC will enjoy these detailed readings.

		KerbinInSpace = #autoLOC_501555 //#autoLOC_501555 = The sensor finds subtle changes in the gravity field of Kerbin. The science team will want to see these readings!
		KerbinSrfLanded = #autoLOC_501556 //#autoLOC_501556 = The sensor seems to think it's being calibrated.
		KerbinSrfLanded = #autoLOC_501557 //#autoLOC_501557 = After reading the manual a few times, the command team is able to take an accurate reading of the local gravity.
		KerbinInSpaceGrassLands = #autoLOC_501558 //#autoLOC_501558 = The instrument surveys the gravity over the grasslands. It appears the field is very stable here.
		KerbinInSpaceHighlands = #autoLOC_501559 //#autoLOC_501559 = The instrument surveys the highlands of Kerbin. The rolling hills seem to affect local gravity slightly.
		KerbinInSpaceMountains = #autoLOC_501560 //#autoLOC_501560 = The field appears to be strongest along these mountain ranges.
		KerbinInSpaceDeserts = #autoLOC_501561 //#autoLOC_501561 = The dunes appear to have a very stable gravitation, though some spikes would indicate the underground terrain varies in composition.
		KerbinInSpaceBadlands = #autoLOC_501562 //#autoLOC_501562 = The sensor reads the gravity over the badlands of Kerbin.
		KerbinInSpaceIceCaps = #autoLOC_501563 //#autoLOC_501563 = The sensor detects variances under the surface of the ice. Is there a landmass under that ice?
		KerbinInSpaceShores = #autoLOC_501564 //#autoLOC_501564 = The sensor passes over the shores of Kerbin. The readings appear to be nominal.
		KerbinInSpaceWater = #autoLOC_501565 //#autoLOC_501565 = The sensor shows a surprising variance as it passes over the oceans, hinting at the varied topography deep below the waters.
		KerbinSrfSplashedWater = #autoLOC_501566 //#autoLOC_501566 = The sensor has detected changes in the local gravity that seem to be related to the passing of the Mun.

		MunInSpace = #autoLOC_501567 //#autoLOC_501567 = The instrument surveys for changes in the gravity field of the Mun. This data will help to accurately calculate the mass of the body.
		MunSrfLanded = #autoLOC_501568 //#autoLOC_501568 = The sensor conducts a detailed survey of the local gravity.
		MunSrfLanded = #autoLOC_501569 //#autoLOC_501569 = After calibration, the sensor is able to detect the interplay of gravity between Kerbin and the Mun.

		MinmusInSpace = #autoLOC_501570 //#autoLOC_501570 = Passing over the surface, the sensor sweeps across the gravitational field of Minmus.
		MinmusSrfLanded = #autoLOC_501571 //#autoLOC_501571 = The sensor takes detailed readings of the local gravity on Minmus.
		MinmusSrfLanded = #autoLOC_501572 //#autoLOC_501572 = The scan picks up the subtle changes in field caused by the orbit of the Mun. This data will provide valuable insight into the local planetary system.

		DunaInSpace = #autoLOC_501573 //#autoLOC_501573 = The sensor passes over the mottled surface of Duna. Gravity appears lowest in the massive canyon that stretches across the surface.
		DunaSrfLanded = #autoLOC_501574 //#autoLOC_501574 = The sensor performs a detailed and calibrated sweep of the local gravity on Duna.
		DunaSrfLanded = #autoLOC_501575 //#autoLOC_501575 = The sensor is able to record the affects of Ike as it orbits Duna.

		DresInSpace = #autoLOC_501576 //#autoLOC_501576 = The sensor sweeps the surface and finds the average gravitational pull to be quite low for a planet.
		DresSrfLanded = #autoLOC_501577 //#autoLOC_501577 = The sensor measures the local gravity in fine detail and records all variations.

		JoolInSpace = #autoLOC_501578 //#autoLOC_501578 = The sensor recalibrates to measure the massive gravitational forces of Jool.
		JoolInSpace = #autoLOC_501579 //#autoLOC_501579 = The sensor picks up a wealth of information about the local planetary system.
		JoolSrfLanded = #autoLOC_501580 //#autoLOC_501580 = The instrument has been crushed by the massive gravitational forces. Science!

		LaytheInSpace = #autoLOC_501581 //#autoLOC_501581 = The sensor scans the gravity of Laythe. It hints at diverse terrain under the water.
		LaytheSrfLanded = #autoLOC_501582 //#autoLOC_501582 = The sensor scans the local gravity of Laythe, recording the influence of Jool.
		LaytheSrfSplashed = #autoLOC_501583 //#autoLOC_501583 = The sensor provides detailed gravity information in relation to the tides.

		VallInSpace = #autoLOC_501584 //#autoLOC_501584 = Scanning from orbit provides a clearer picture of the internal makeup of Vall.
		VallSrfLanded = #autoLOC_501585 //#autoLOC_501585 = Scanning the surface details gravitational fluctuations in the shifting interior of the planet.

		TyloInSpace = #autoLOC_501586 //#autoLOC_501586 = The planet has lower gravity than anticipated. This will give our scientists information about the interior makeup of Tylo.
		TyloSrfLanded = #autoLOC_501587 //#autoLOC_501587 = Detailed scans hint at hollow spaces in the interior of the planet.

		BopInSpace = #autoLOC_501588 //#autoLOC_501588 = Orbiting Bop allows for scans of the varied surface. Interesting stuff!
		BopSrfLanded = #autoLOC_501589 //#autoLOC_501589 = The sensor is giving odd readings here...

		PolInSpace = #autoLOC_501590 //#autoLOC_501590 = The sensor picks up multiple layers under the surface of the planet.
		PolSrfLanded = #autoLOC_501591 //#autoLOC_501591 = Landing on the planet has allowed for highly detailed scans of the interior gravity on Pol.

		EelooInSpace = #autoLOC_501592 //#autoLOC_501592 = Though the surface appears to be smooth, there are fluctuations under the surface of the planet.
		EelooSrfLanded = #autoLOC_501593 //#autoLOC_501593 = Gravity scans are very clear here. There appears to be little influence from other bodies.
	}
}

EXPERIMENT_DEFINITION
{
	id = atmosphereAnalysis
	title = #autoLOC_501018 //#autoLOC_501018 = Atmosphere Analysis
	baseValue = 20
	scienceCap = 24
	dataScale = 10
	
	requireAtmosphere = True
	situationMask = 13
	biomeMask = 13
	
	RESULTS
	{
		default = #autoLOC_501594 //#autoLOC_501594 = You run an atmospheric analysis, recording various measurements like temperature, pressure and atmospheric composition.

		MohoSrf = #autoLOC_501595 //#autoLOC_501595 = There appears to be no atmosphere here, though there are trace elements being detected close to the surface.

		EveSrf = #autoLOC_501596 //#autoLOC_501596 = This might be an atmosphere, but it's definitely not something you want to breathe.

		GillySrf = #autoLOC_501597 //#autoLOC_501597 = There is no detectable atmosphere.

		KerbinFlyingHigh = #autoLOC_501598 //#autoLOC_501598 = It seems there is very little atmosphere at these altitudes. Make sure you're properly suited up if you plan on going outside.
		KerbinSrfLanded = #autoLOC_501599 //#autoLOC_501599 = Temperature and Pressure readings suggest today is as good a time for flying as any.
		KerbinSrfLandedDeserts = #autoLOC_501600 //#autoLOC_501600 = It's very hot and dry out in the Deserts. The sensors were getting clogged up with dust.
		KerbinSrfLandedIceCaps = #autoLOC_501601 //#autoLOC_501601 = The polar atmosphere was found to be very, very cold indeed. Some sensors froze shut, but we're reasonably sure this is still air.

		MunSrf = #autoLOC_501602 //#autoLOC_501602 = Instruments detect a faint particulate aura around the surface. Not an atmosphere, but it may explain the reported lights on the horizon.

		MinmusSrf = #autoLOC_501603 //#autoLOC_501603 = There are detectable releases of gasses, but nothing that could be considered an atmosphere.

		DunaSrf = #autoLOC_501604 //#autoLOC_501604 = The atmosphere on Duna is very, very thin. It might be possible to fly in it with large enough wings, or a fast enough aircraft.
		DunaSrf = #autoLOC_501605 //#autoLOC_501605 = There appears to be a larger concentration of heavy isotopes in the atmosphere than on Kerbin.

		IkeSrf = #autoLOC_501606 //#autoLOC_501606 = You run an analysis on the non-existent atmosphere.

		DresSrf = #autoLOC_501607 //#autoLOC_501607 = There does not appear to be an atmosphere here.

		JoolFlyingHigh = #autoLOC_501608 //#autoLOC_501608 = The atmospheric pressures are very high here, and you detect a large number of gasses.
		JoolFlyingLow = #autoLOC_501609 //#autoLOC_501609 = The instrument is having trouble sampling at these densities. The gasses are beginning to liquify under pressure.
		JoolSrfLanded = #autoLOC_501610 //#autoLOC_501610 = The instrument has mostly compressed into an unrecognizable mass of metal.

		LaytheSrfLanded = #autoLOC_501611 //#autoLOC_501611 = The atmosphere on Laythe appears to be very similar to that of Kerbin. I wouldn't volunteer to go out first without a helmet on, however.
		LaytheSrfLanded = #autoLOC_501612 //#autoLOC_501612 = Taking your helmet off here probably won't kill you... very quickly.

		VallSrfLanded = #autoLOC_501613 //#autoLOC_501613 = There are traces of cryovolcanic compounds. But not a full atmosphere.

		TyloSrfLanded = #autoLOC_501614 //#autoLOC_501614 = There appear to be only faint traces of the heaviest isotopes on the surface.

		BopSrfLanded = #autoLOC_501615 //#autoLOC_501615 = The sensors detected organic compounds for a second. Possibly a mistake.
		BopSrfLanded = #autoLOC_501616 //#autoLOC_501616 = The sensors detect nothing out of the ordinary. Surely nothing could live here.

		PolSrfLanded = #autoLOC_501617 //#autoLOC_501617 = There is no atmosphere to speak of, but you sample the temperature anyways.

		EelooSrfLanded = #autoLOC_501618 //#autoLOC_501618 = There appears to be a tenuous atmospheric coating around the planet. But it is too thin to affect any spacecraft landing here.
	}
}

