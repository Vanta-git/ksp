			FundsMultiplier = 1 // The multiplier this request places on funds in Trivial contracts
			ScienceMultiplier = 1 // The multiplier this request places on science in Trivial contracts
			ReputationMultiplier = 1 // The multiplier this request places on reputation in Trivial contracts
			MaxOrbitEccentricityFactor = 0.05 // The multiplier this request places on the orbit eccentricity in Trivial contracts
			OrbitAltitudeFactor = 0.33 // The multiplier this request places on the orbit altitude in Trivial contracts
			OrbitInclinationFactor = 0.25 // The multiplier this request places on the orbit inclination in Trivial contracts
		}
		Significant // Medium Contracts
		{
			FundsMultiplier = 1.25 // The multiplier this request places on funds in Significant contracts
			ScienceMultiplier = 1 // The multiplier this request places on science in Significant contracts
			ReputationMultiplier = 1 // The multiplier this request places on reputation in Significant contracts
			MaxOrbitEccentricityFactor = 0.05 // The multiplier this request places on the orbit eccentricity in Significant contracts
			OrbitAltitudeFactor = 0.5  // The multiplier this request places on the orbit altitude in Significant contracts
			OrbitInclinationFactor = 1.0 // The multiplier this request places on the orbit inclination in Significant contracts
		}
		Exceptional // Difficult Contracts
		{
			FundsMultiplier = 2 // The multiplier this request places on funds in Exceptional contracts
			ScienceMultiplier = 1 // The multiplier this request places on science in Exceptional contracts
			ReputationMultiplier = 2 // The multiplier this request places on reputation in Exceptional contracts
			MaxOrbitEccentricityFactor = 0.05 // The multiplier this request places on the orbit eccentricity in Exceptional contracts
			OrbitAltitudeFactor = 0.8 // The multiplier this request places on the orbit altitude in Exceptional contracts
			OrbitInclinationFactor = 1.0 // The multiplier this request places on the orbit inclination in Exceptional contracts
		}
	}
}
